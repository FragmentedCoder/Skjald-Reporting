{
  "lookup_tables": {
    "severity": {
      "critical": "Kritisk",
      "high": "Høj",
      "medium": "Middel",
      "low": "Lav"
    }
  },
  "cases": [
    {
      "id": "range",
      "need": "Value within a range",
      "expr": "cvss >= 7.0 && cvss < 9.0",
      "vars": {
        "cvss": 7.5
      },
      "expect": true
    },
    {
      "id": "else_if_chain",
      "need": "IF / ELSE IF / ELSE",
      "expr": "cvss >= 9.0 ? \"Critical\" : cvss >= 7.0 ? \"High\" : cvss >= 4.0 ? \"Medium\" : \"Low\"",
      "vars": {
        "cvss": 7.5
      },
      "expect": "High"
    },
    {
      "id": "and_or_not",
      "need": "AND / OR / NOT",
      "expr": "found && !(blocked || monitored)",
      "vars": {
        "found": true,
        "blocked": false,
        "monitored": false
      },
      "expect": true
    },
    {
      "id": "xor_operator",
      "need": "XOR without a custom function",
      "expr": "a != b",
      "vars": {
        "a": true,
        "b": false
      },
      "expect": true
    },
    {
      "id": "xor_function",
      "need": "XOR as a function",
      "expr": "xor(a, b)",
      "vars": {
        "a": true,
        "b": true
      },
      "expect": false
    },
    {
      "id": "switch_function_default",
      "need": "SWITCH, falling through to the default",
      "expr": "switch(lang, {\"da\": \"Danish\", \"en\": \"English\"}, \"Other\")",
      "vars": {
        "lang": "de"
      },
      "expect": "Other"
    },
    {
      "id": "switch_function_hit",
      "need": "SWITCH, matching a case",
      "expr": "switch(lang, {\"da\": \"Danish\", \"en\": \"English\"}, \"Other\")",
      "vars": {
        "lang": "da"
      },
      "expect": "Danish"
    },
    {
      "id": "switch_plain_cel",
      "need": "SWITCH in plain CEL",
      "expr": "lang in {\"da\": \"Danish\"} ? {\"da\": \"Danish\"}[lang] : \"Other\"",
      "vars": {
        "lang": "da"
      },
      "expect": "Danish"
    },
    {
      "id": "regex_match",
      "need": "Built-in matches(): regular expression match",
      "expr": "ip.matches(\"^198\\\\.51\\\\.100\\\\.[0-9]+$\")",
      "vars": {
        "ip": "198.51.100.23"
      },
      "expect": true
    },
    {
      "id": "regex_match_ipv6",
      "need": "Built-in matches(): IPv6 pattern",
      "expr": "ip.matches(\"^[0-9a-f:]+$\")",
      "vars": {
        "ip": "2001:db8::5"
      },
      "expect": true
    },
    {
      "id": "regex_replace",
      "need": "Text replacement with a regular expression",
      "expr": "re_replace(log, \"pw=\\\\S+\", \"pw=****\")",
      "vars": {
        "log": "user=a.berg pw=Hunter2 src=198.51.100.23"
      },
      "expect": "user=a.berg pw=**** src=198.51.100.23"
    },
    {
      "id": "text_replace",
      "need": "Plain text replacement",
      "expr": "text.replace(\"Fjordvik\", \"Kunden\")",
      "vars": {
        "text": "Fjordvik Logistik A/S"
      },
      "expect": "Kunden Logistik A/S"
    },
    {
      "id": "upper_case",
      "need": "Upper-case text",
      "expr": "text.upperAscii()",
      "vars": {
        "text": "critical"
      },
      "expect": "CRITICAL"
    },
    {
      "id": "list_exists",
      "need": "Any item in a list",
      "expr": "ips.exists(i, i.startsWith(\"203.\"))",
      "vars": {
        "ips": [
          "198.51.100.23",
          "203.0.113.77",
          "2001:db8::5"
        ]
      },
      "expect": true
    },
    {
      "id": "list_all",
      "need": "Every item in a list",
      "expr": "attempts.all(n, n > 0)",
      "vars": {
        "attempts": [
          1204,
          611,
          27
        ]
      },
      "expect": true
    },
    {
      "id": "list_filter_count",
      "need": "Count matching items",
      "expr": "ips.filter(i, i.contains(\":\")).size()",
      "vars": {
        "ips": [
          "198.51.100.23",
          "203.0.113.77",
          "2001:db8::5"
        ]
      },
      "expect": 1
    },
    {
      "id": "sum_function",
      "need": "Sum a column",
      "expr": "sum(attempts)",
      "vars": {
        "attempts": [
          1204,
          611,
          27
        ]
      },
      "expect": 1842
    },
    {
      "id": "lookup_function",
      "need": "Lookup table",
      "expr": "lookup(\"severity\", level)",
      "vars": {
        "level": "critical"
      },
      "expect": "Kritisk"
    },
    {
      "id": "missing_value",
      "need": "Missing answer gets a default",
      "expr": "has(report.reviewer) ? report.reviewer : \"Not assigned\"",
      "vars": {
        "report": {
          "technician": "Freja Holm"
        }
      },
      "expect": "Not assigned"
    },
    {
      "id": "number_to_text",
      "need": "Number into text",
      "expr": "string(count) + \" attempts\"",
      "vars": {
        "count": 1842
      },
      "expect": "1842 attempts"
    },
    {
      "id": "int_vs_double",
      "need": "Whole number compared with a decimal",
      "expr": "count > 1000.5",
      "vars": {
        "count": 1842
      },
      "expect": true
    },
    {
      "id": "deadline",
      "need": "Date arithmetic (NIS2 72-hour deadline passed)",
      "expr": "timestamp(detected) + duration(\"72h\") < timestamp(now)",
      "vars": {
        "detected": "2026-10-21T01:14:00Z",
        "now": "2026-10-24T02:00:00Z"
      },
      "expect": true
    },
    {
      "id": "danish_length",
      "need": "Length of Danish text",
      "expr": "name.size()",
      "vars": {
        "name": "Æblegrød"
      },
      "expect": 8
    },
    {
      "id": "emoji_length",
      "need": "Length of text with an emoji (code points)",
      "expr": "text.size()",
      "vars": {
        "text": "🛡️ ok"
      },
      "expect": 5
    },
    {
      "id": "divide_by_zero",
      "need": "Errors are errors, not crashes",
      "expr": "count / zero",
      "vars": {
        "count": 10,
        "zero": 0
      },
      "expect_error": true
    },
    {
      "id": "unknown_variable",
      "need": "Unknown names are rejected",
      "expr": "nonexistent > 1",
      "vars": {},
      "expect_error": true
    },
    {
      "id": "regex_lookahead",
      "need": "Built-in matches(): non-RE2 syntax rejected",
      "expr": "text.matches(\"a(?=b)\")",
      "vars": {
        "text": "abc"
      },
      "expect_error": true
    },
    {
      "id": "regex_redos",
      "need": "Built-in matches(): hostile pattern stays fast",
      "expr": "text.matches(\"^(a+)+$\")",
      "vars": {
        "text": "aaaaaaaaaaaaaaaaaaaaaaaaa!"
      },
      "expect": false,
      "time_limit_ms": 100
    },
    {
      "id": "re_match",
      "need": "Skjald re_match(): regular expression match on RE2",
      "expr": "re_match(ip, \"^198\\\\.51\\\\.100\\\\.[0-9]+$\")",
      "vars": {
        "ip": "198.51.100.23"
      },
      "expect": true
    },
    {
      "id": "re_match_lookahead",
      "need": "Skjald re_match(): non-RE2 syntax rejected on both sides",
      "expr": "re_match(text, \"a(?=b)\")",
      "vars": {
        "text": "abc"
      },
      "expect_error": true
    },
    {
      "id": "re_match_redos",
      "need": "Skjald re_match(): hostile pattern stays fast",
      "expr": "re_match(text, \"^(a+)+$\")",
      "vars": {
        "text": "aaaaaaaaaaaaaaaaaaaaaaaaa!"
      },
      "expect": false,
      "time_limit_ms": 100
    }
  ]
}
