{
  "about": "One test file for both CEL engines: pytest runs it on cel-expr-python (backend/tests/test_cel.py) and vitest on cel-js (frontend/src/lib/cel/cel.test.ts). Each case declares its names and their types, as a template does. 'expect' is the result (timestamps as {\"timestamp\": \"...\"}), 'type' the result's type where it matters, 'error' an expected failure: 'invalid' is Skjald's own validator, 'compile' a syntax or type error, 'runtime' a failure while evaluating; where it gives a message, both sides must say exactly that. 'references' lists the declared names an expression reads. Options default to the Europe/Copenhagen time zone and English. Started from the 31 cases of spikes/expression-language.",
  "tables": {
    "severity": {"columns": ["label"], "rows": {"critical": ["Kritisk"], "high": ["Høj"], "medium": ["Middel"], "low": ["Lav"]}},
    "media": {"columns": ["method", "standard"], "rows": {"hdd": ["Degaussing and shredding", "NIST SP 800-88 Destroy"], "ssd": ["Shredding", "NIST SP 800-88 Destroy"]}}
  },
  "cases": [
    {"id": "range", "need": "Value within a range", "expr": "answers.cvss >= 7.0 && answers.cvss < 9.0", "declare": {"answers.cvss": "double"}, "vars": {"answers": {"cvss": 7.5}}, "expect": true, "references": ["answers.cvss"]},
    {"id": "else_if_chain", "need": "IF / ELSE IF / ELSE", "expr": "answers.cvss >= 9.0 ? \"Critical\" : answers.cvss >= 7.0 ? \"High\" : answers.cvss >= 4.0 ? \"Medium\" : \"Low\"", "declare": {"answers.cvss": "double"}, "vars": {"answers": {"cvss": 7.5}}, "expect": "High", "type": "string"},
    {"id": "and_or_not", "need": "AND / OR / NOT", "expr": "answers.found && !(answers.blocked || answers.monitored)", "declare": {"answers.found": "bool", "answers.blocked": "bool", "answers.monitored": "bool"}, "vars": {"answers": {"found": true, "blocked": false, "monitored": false}}, "expect": true, "references": ["answers.blocked", "answers.found", "answers.monitored"]},
    {"id": "xor_operator", "need": "XOR without a custom function", "expr": "answers.a != answers.b", "declare": {"answers.a": "bool", "answers.b": "bool"}, "vars": {"answers": {"a": true, "b": false}}, "expect": true},
    {"id": "xor_function", "need": "XOR as a function", "expr": "xor(answers.a, answers.b)", "declare": {"answers.a": "bool", "answers.b": "bool"}, "vars": {"answers": {"a": true, "b": true}}, "expect": false},
    {"id": "switch_function_default", "need": "SWITCH, falling through to the default", "expr": "switch(answers.lang, {\"da\": \"Danish\", \"en\": \"English\"}, \"Other\")", "declare": {"answers.lang": "string"}, "vars": {"answers": {"lang": "de"}}, "expect": "Other"},
    {"id": "switch_function_hit", "need": "SWITCH, matching a case", "expr": "switch(answers.lang, {\"da\": \"Danish\", \"en\": \"English\"}, \"Other\")", "declare": {"answers.lang": "string"}, "vars": {"answers": {"lang": "da"}}, "expect": "Danish"},
    {"id": "switch_number_keys", "need": "SWITCH on a whole number", "expr": "switch(answers.level, {1: \"Low\", 2: \"Medium\", 3: \"High\"}, \"Unknown\")", "declare": {"answers.level": "int"}, "vars": {"answers": {"level": 2}}, "expect": "Medium"},
    {"id": "switch_to_number", "need": "SWITCH giving a number", "expr": "switch(answers.size, {\"small\": 1.5, \"large\": 4.0}, 0.0) * 2.0", "declare": {"answers.size": "string"}, "vars": {"answers": {"size": "large"}}, "expect": 8.0, "type": "double"},
    {"id": "switch_to_int", "need": "SWITCH giving a whole number", "expr": "switch(answers.size, {\"small\": 1, \"large\": 4}, 0) + 1", "declare": {"answers.size": "string"}, "vars": {"answers": {"size": "small"}}, "expect": 2, "type": "int"},
    {"id": "switch_plain_cel", "need": "SWITCH in plain CEL", "expr": "answers.lang in {\"da\": \"Danish\"} ? {\"da\": \"Danish\"}[answers.lang] : \"Other\"", "declare": {"answers.lang": "string"}, "vars": {"answers": {"lang": "da"}}, "expect": "Danish"},
    {"id": "matches_refused", "need": "Built-in matches() is refused: it runs on JavaScript's backtracking engine in the browser", "expr": "answers.ip.matches(\"^198\\\\.51\\\\.100\\\\.[0-9]+$\")", "declare": {"answers.ip": "string"}, "vars": {"answers": {"ip": "198.51.100.23"}}, "error": {"kind": "invalid", "message": "matches() isn't allowed in templates: use re_match(), which uses the same safe regular expressions on the server and in the browser."}},
    {"id": "matches_refused_global", "need": "matches() refused in its global form too", "expr": "matches(answers.ip, \"a+\")", "declare": {"answers.ip": "string"}, "vars": {"answers": {"ip": "a"}}, "error": {"kind": "invalid", "message": "matches() isn't allowed in templates: use re_match(), which uses the same safe regular expressions on the server and in the browser."}},
    {"id": "matches_in_text_is_fine", "need": "The word matches inside quotes is only text", "expr": "\"matches(x)\" + 'matches(' + \"\"\"matches(\"\"\"", "declare": {}, "vars": {}, "expect": "matches(x)matches(matches("},
    {"id": "regex_replace", "need": "Text replacement with a regular expression", "expr": "re_replace(answers.log, \"pw=\\\\S+\", \"pw=****\")", "declare": {"answers.log": "string"}, "vars": {"answers": {"log": "user=a.berg pw=Hunter2 src=198.51.100.23"}}, "expect": "user=a.berg pw=**** src=198.51.100.23"},
    {"id": "regex_replace_groups", "need": "Replacement with numbered groups", "expr": "re_replace(\"Berg, Anna\", \"(\\\\w+), (\\\\w+)\", \"$2 $1\")", "declare": {}, "vars": {}, "expect": "Anna Berg"},
    {"id": "regex_replace_named_group", "need": "Replacement with a named group", "expr": "re_replace(\"host=srv-01\", \"host=(?P<name>[a-z0-9-]+)\", \"${name}.fjordvik.example\")", "declare": {}, "vars": {}, "expect": "srv-01.fjordvik.example"},
    {"id": "regex_replace_dollar", "need": "$$ in a replacement is a dollar sign, and a backslash stays a backslash", "expr": "re_replace(\"cost: 5\", \"[0-9]+\", \"$$$0 \\\\ each\")", "declare": {}, "vars": {}, "expect": "cost: $5 \\ each"},
    {"id": "regex_replace_empty_matches", "need": "A pattern that can match nothing replaces between every character", "expr": "re_replace(\"abc\", \"x*\", \"-\")", "declare": {}, "vars": {}, "expect": "-a-b-c-"},
    {"id": "regex_replace_unicode", "need": "Regular expressions count characters, not bytes", "expr": "re_replace(\"Æblegrød 🛡️\", \"^.\", \"_\") + \"|\" + re_replace(\"Æblegrød\", \"ø\", \"oe\")", "declare": {}, "vars": {}, "expect": "_blegrød 🛡️|Æblegroed"},
    {"id": "text_replace", "need": "Plain text replacement", "expr": "answers.text.replace(\"Fjordvik\", \"Kunden\")", "declare": {"answers.text": "string"}, "vars": {"answers": {"text": "Fjordvik Logistik A/S, Fjordvik"}}, "expect": "Kunden Logistik A/S, Kunden"},
    {"id": "text_replace_special", "need": "Plain replacement treats every character literally", "expr": "\"a.b.c\".replace(\".\", \"$1\")", "declare": {}, "vars": {}, "expect": "a$1b$1c"},
    {"id": "upper_case", "need": "Upper-case text", "expr": "answers.text.upperAscii()", "declare": {"answers.text": "string"}, "vars": {"answers": {"text": "critical"}}, "expect": "CRITICAL"},
    {"id": "list_exists", "need": "Any item in a list", "expr": "answers.ips.exists(i, i.startsWith(\"203.\"))", "declare": {"answers.ips": "list<string>"}, "vars": {"answers": {"ips": ["198.51.100.23", "203.0.113.77", "2001:db8::5"]}}, "expect": true},
    {"id": "list_all", "need": "Every item in a list", "expr": "answers.attempts.all(n, n > 0)", "declare": {"answers.attempts": "list<int>"}, "vars": {"answers": {"attempts": [1204, 611, 27]}}, "expect": true},
    {"id": "list_filter_count", "need": "Count matching items", "expr": "answers.ips.filter(i, i.contains(\":\")).size()", "declare": {"answers.ips": "list<string>"}, "vars": {"answers": {"ips": ["198.51.100.23", "203.0.113.77", "2001:db8::5"]}}, "expect": 1, "type": "int"},
    {"id": "list_exists_one", "need": "Exactly one item in a list", "expr": "answers.ips.exists_one(i, i.contains(\":\"))", "declare": {"answers.ips": "list<string>"}, "vars": {"answers": {"ips": ["198.51.100.23", "2001:db8::5"]}}, "expect": true},
    {"id": "list_in", "need": "Whether a list holds a value", "expr": "\"Firewall\" in answers.systems", "declare": {"answers.systems": "list<string>"}, "vars": {"answers": {"systems": ["Mail", "Firewall"]}}, "expect": true},
    {"id": "empty_list", "need": "An empty list: nothing exists, everything holds, the sum is 0", "expr": "!answers.rows.exists(r, r.attempts > 0) && answers.rows.all(r, r.attempts > 0) && sum(answers.rows.map(r, r.attempts)) == 0", "declare": {"answers.rows": "list<map<string, dyn>>"}, "vars": {"answers": {"rows": []}}, "expect": true},
    {"id": "sum_function", "need": "Sum a list", "expr": "sum(answers.attempts)", "declare": {"answers.attempts": "list<int>"}, "vars": {"answers": {"attempts": [1204, 611, 27]}}, "expect": 1842, "type": "int"},
    {"id": "sum_column", "need": "Sum one column of a repeating group", "expr": "sum(answers.attackers.map(r, r.attempts))", "declare": {"answers.attackers": "list<map<string, dyn>>"}, "vars": {"answers": {"attackers": [{"ip": "198.51.100.23", "attempts": 1204}, {"ip": "203.0.113.77", "attempts": 611}]}}, "expect": 1815},
    {"id": "sum_decimals", "need": "A sum of decimals is a decimal", "expr": "sum(answers.hours) > 3.0", "declare": {"answers.hours": "list<double>"}, "vars": {"answers": {"hours": [1.5, 2.25]}}, "expect": true},
    {"id": "sum_mixed", "need": "A sum of whole numbers and decimals is a decimal", "expr": "sum([1, 2.5]) == 3.5", "declare": {}, "vars": {}, "expect": true},
    {"id": "row_column_check", "need": "A condition on a row's column", "expr": "answers.attackers.exists(r, r.attempts > 1000 && r.ip.startsWith(\"198.\"))", "declare": {"answers.attackers": "list<map<string, dyn>>"}, "vars": {"answers": {"attackers": [{"ip": "198.51.100.23", "attempts": 1204}]}}, "expect": true, "references": ["answers.attackers"]},
    {"id": "lookup_function", "need": "Lookup table", "expr": "lookup(\"severity\", answers.level)", "declare": {"answers.level": "string"}, "vars": {"answers": {"level": "critical"}}, "expect": "Kritisk"},
    {"id": "lookup_column", "need": "Lookup table with a named column", "expr": "lookup(\"media\", answers.media) + \" (\" + lookup(\"media\", answers.media, \"standard\") + \")\"", "declare": {"answers.media": "string"}, "vars": {"answers": {"media": "ssd"}}, "expect": "Shredding (NIST SP 800-88 Destroy)"},
    {"id": "lookup_missing", "need": "A missing table, key or column gives empty text", "expr": "lookup(\"severity\", \"unheard of\") + lookup(\"nope\", \"x\") + lookup(\"media\", \"hdd\", \"colour\")", "declare": {}, "vars": {}, "expect": ""},
    {"id": "missing_value", "need": "A row without a column gets a default", "expr": "has(item.reviewer) ? item.reviewer : \"Not assigned\"", "declare": {"item": "map<string, dyn>"}, "vars": {"item": {"technician": "Freja Holm"}}, "expect": "Not assigned"},
    {"id": "blank_answer", "need": "A blank answer is empty text, never missing", "expr": "answers.summary == \"\" ? \"No summary\" : answers.summary", "declare": {"answers.summary": "string"}, "vars": {"answers": {"summary": ""}}, "expect": "No summary"},
    {"id": "number_to_text", "need": "Number into text", "expr": "string(answers.count) + \" attempts\"", "declare": {"answers.count": "int"}, "vars": {"answers": {"count": 1842}}, "expect": "1842 attempts"},
    {"id": "int_vs_double", "need": "A whole number compared with a decimal is caught, with a hint (Google's engine refuses it; the browser is held to the same)", "expr": "answers.count > 1000.5", "declare": {"answers.count": "int"}, "vars": {"answers": {"count": 1842}}, "error": {"kind": "compile", "message": "A whole number can't be compared with a decimal: write 9.0 rather than 9, or convert one side with double() or int()."}},
    {"id": "double_vs_int_literal", "need": "A decimal answer compared with a whole number is caught too", "expr": "answers.cvss >= 9", "declare": {"answers.cvss": "double"}, "vars": {"answers": {"cvss": 9.8}}, "error": {"kind": "compile", "message": "A whole number can't be compared with a decimal: write 9.0 rather than 9, or convert one side with double() or int()."}},
    {"id": "mixed_inside_list_function", "need": "A mixed comparison inside a list function is caught", "expr": "answers.attempts.all(n, n > 0.5)", "declare": {"answers.attempts": "list<int>"}, "vars": {"answers": {"attempts": [1, 2]}}, "error": {"kind": "compile", "message": "A whole number can't be compared with a decimal: write 9.0 rather than 9, or convert one side with double() or int()."}},
    {"id": "mixed_equality", "need": "A whole number is never equal to a decimal by mistake", "expr": "answers.count == 1842.0", "declare": {"answers.count": "int"}, "vars": {"answers": {"count": 1842}}, "error": {"kind": "compile", "message": "A whole number can't be compared with a decimal: write 9.0 rather than 9, or convert one side with double() or int()."}},
    {"id": "mixed_arithmetic", "need": "Whole numbers and decimals don't mix in sums", "expr": "answers.count + 0.5", "declare": {"answers.count": "int"}, "vars": {"answers": {"count": 1842}}, "error": {"kind": "compile", "message": "Whole numbers and decimals can't be mixed in a sum: write 9.0 rather than 9, or convert one side with double() or int()."}},
    {"id": "converted_comparison", "need": "Converting one side compares a whole number with a decimal", "expr": "double(answers.count) > 1000.5 && answers.count > 1000", "declare": {"answers.count": "int"}, "vars": {"answers": {"count": 1842}}, "expect": true},
    {"id": "dyn_vs_double", "need": "A column of a repeating group can be compared with either kind of number", "expr": "answers.rows.exists(r, r.n > 1.5) && answers.rows.exists(r, r.n > 1)", "declare": {"answers.rows": "list<map<string, dyn>>"}, "vars": {"answers": {"rows": [{"n": 2}]}}, "expect": true},
    {"id": "whole_decimal_answer", "need": "A decimal answer that happens to be whole stays a decimal", "expr": "answers.cvss / 2.0", "declare": {"answers.cvss": "double"}, "vars": {"answers": {"cvss": 7}}, "expect": 3.5, "type": "double"},
    {"id": "int_arithmetic", "need": "Whole numbers stay whole", "expr": "answers.count / 7", "declare": {"answers.count": "int"}, "vars": {"answers": {"count": 50}}, "expect": 7, "type": "int"},
    {"id": "conversions", "need": "Converting between numbers and text", "expr": "int(\"42\") + int(7.9) == 49 && double(3) / 2.0 == 1.5 && double(\"2.5\") == 2.5", "declare": {}, "vars": {}, "expect": true},
    {"id": "format_number_en", "need": "Numbers written the English way", "expr": "format_number(answers.amount, 2)", "declare": {"answers.amount": "double"}, "vars": {"answers": {"amount": 1234567.891}}, "expect": "1,234,567.89"},
    {"id": "format_number_da", "need": "Numbers written the Danish way", "expr": "format_number(answers.amount, 1)", "declare": {"answers.amount": "double"}, "vars": {"answers": {"amount": 1234.25}}, "options": {"language": "da"}, "expect": "1.234,3"},
    {"id": "format_number_half", "need": "Halves round away from zero, from the number as written", "expr": "format_number(2.5, 0) + \" \" + format_number(-2.5, 0) + \" \" + format_number(1.005, 2) + \" \" + format_number(0.125, 2)", "declare": {}, "vars": {}, "expect": "3 -3 1.01 0.13"},
    {"id": "format_number_int", "need": "Whole numbers with decimals and grouping", "expr": "format_number(answers.count, 0) + \" / \" + format_number(answers.count, 2)", "declare": {"answers.count": "int"}, "vars": {"answers": {"count": -1842}}, "expect": "-1,842 / -1,842.00"},
    {"id": "format_number_small", "need": "Small numbers, and no minus sign on a number that rounds to zero", "expr": "format_number(0.0001, 3) + \" \" + format_number(0.0, 1) + \" \" + format_number(-0.04, 1)", "declare": {}, "vars": {}, "expect": "0.000 0.0 0.0"},
    {"id": "deadline", "need": "Date arithmetic (NIS2 72-hour deadline passed)", "expr": "answers.detected + duration(\"72h\") < report.date", "declare": {"answers.detected": "timestamp", "report.date": "timestamp"}, "vars": {"answers": {"detected": "2026-10-21T01:14:00Z"}, "report": {"date": "2026-10-24T02:00:00Z"}}, "expect": true, "references": ["answers.detected", "report.date"]},
    {"id": "hours_between", "need": "Hours between two points in time", "expr": "hours_between(answers.detected, answers.reported) <= 24.0", "declare": {"answers.detected": "timestamp", "answers.reported": "timestamp"}, "vars": {"answers": {"detected": "2026-10-21T01:14:00Z", "reported": "2026-10-21T19:44:00Z"}}, "expect": true},
    {"id": "add_hours", "need": "A deadline a number of hours later", "expr": "add_hours(answers.detected, 72)", "declare": {"answers.detected": "timestamp"}, "vars": {"answers": {"detected": "2026-10-21T01:14:00Z"}}, "expect": {"timestamp": "2026-10-24T01:14:00Z"}, "type": "timestamp"},
    {"id": "date_local", "need": "A local date is read in the company's time zone", "expr": "date(\"2026-10-21T14:30\")", "declare": {}, "vars": {}, "expect": {"timestamp": "2026-10-21T12:30:00Z"}},
    {"id": "date_only", "need": "A date alone is midnight there", "expr": "date(\"2026-12-01\")", "declare": {}, "vars": {}, "expect": {"timestamp": "2026-11-30T23:00:00Z"}},
    {"id": "date_with_offset", "need": "A date with its own offset keeps it", "expr": "date(\"2026-10-21T14:30:15+00:00\") == timestamp(\"2026-10-21T14:30:15Z\") && date(\"2026-10-21T14:30Z\") == timestamp(\"2026-10-21T14:30:00Z\")", "declare": {}, "vars": {}, "expect": true},
    {"id": "date_other_zone", "need": "Another company time zone", "expr": "date(\"2026-10-21T14:30\")", "declare": {}, "vars": {}, "options": {"timezone": "America/New_York"}, "expect": {"timestamp": "2026-10-21T18:30:00Z"}},
    {"id": "date_invalid", "need": "Text that isn't a date fails when evaluated", "expr": "date(\"21/10/2026\")", "declare": {}, "vars": {}, "error": {"kind": "runtime"}},
    {"id": "date_invalid_day", "need": "A day that doesn't exist fails", "expr": "date(\"2026-02-30\")", "declare": {}, "vars": {}, "error": {"kind": "runtime"}},
    {"id": "dst_ambiguous", "need": "A local time that happens twice (summer time ending) means the first", "expr": "hours_between(date(\"2026-10-25T00:00\"), date(\"2026-10-25T02:30\"))", "declare": {}, "vars": {}, "expect": 2.5},
    {"id": "dst_gap", "need": "A local time that never happens (summer time starting) moves on an hour", "expr": "format_date(date(\"2026-03-29T02:30\"), \"HH:mm\")", "declare": {}, "vars": {}, "expect": "03:30"},
    {"id": "add_days_dst", "need": "A calendar day across the end of summer time is 25 hours", "expr": "hours_between(date(\"2026-10-24T12:00\"), add_days(date(\"2026-10-24T12:00\"), 1))", "declare": {}, "vars": {}, "expect": 25.0},
    {"id": "add_days_month_end", "need": "Days roll over months and years", "expr": "format_date(add_days(date(\"2026-12-31\"), 1), \"yyyy-MM-dd\") + \" \" + format_date(add_days(date(\"2026-03-01\"), -1), \"yyyy-MM-dd\")", "declare": {}, "vars": {}, "expect": "2027-01-01 2026-02-28"},
    {"id": "add_hours_dst", "need": "Hours are exact across summer time", "expr": "format_date(add_hours(date(\"2026-10-25T01:30\"), 2), \"HH:mm\")", "declare": {}, "vars": {}, "expect": "02:30"},
    {"id": "days_between", "need": "Calendar days in the company's time zone", "expr": "string(days_between(date(\"2026-10-21T23:50\"), date(\"2026-10-22T00:10\"))) + \" \" + string(days_between(date(\"2026-11-20\"), date(\"2026-10-21\")))", "declare": {}, "vars": {}, "expect": "1 -30"},
    {"id": "format_date_en", "need": "Dates written in English", "expr": "format_date(answers.detected, \"EEEE d MMMM yyyy 'at' HH:mm:ss\")", "declare": {"answers.detected": "timestamp"}, "vars": {"answers": {"detected": "2026-10-21T01:14:05Z"}}, "expect": "Wednesday 21 October 2026 at 03:14:05"},
    {"id": "format_date_da", "need": "Dates written in Danish", "expr": "format_date(answers.detected, \"EEEE 'den' d. MMMM yyyy 'kl.' HH.mm\")", "declare": {"answers.detected": "timestamp"}, "vars": {"answers": {"detected": "2026-10-21T01:14:05Z"}}, "options": {"language": "da"}, "expect": "onsdag den 21. oktober 2026 kl. 03.14"},
    {"id": "format_date_short", "need": "Short and numeric forms", "expr": "format_date(date(\"2026-03-05T07:08:09\"), \"d/M/yy dd.MM.yyyy MMM H:mm\")", "declare": {}, "vars": {}, "options": {"language": "da"}, "expect": "5/3/26 05.03.2026 mar. 7:08"},
    {"id": "format_date_quotes", "need": "Quoted text is kept, and '' is a quote mark", "expr": "format_date(date(\"2026-10-21\"), \"'Week of' d MMM, 'yyyy''s' yyyy\")", "declare": {}, "vars": {}, "expect": "Week of 21 Oct, yyyy's 2026"},
    {"id": "danish_length", "need": "Length of Danish text", "expr": "answers.name.size()", "declare": {"answers.name": "string"}, "vars": {"answers": {"name": "Æblegrød"}}, "expect": 8},
    {"id": "emoji_length", "need": "Length of text with an emoji (code points)", "expr": "answers.text.size()", "declare": {"answers.text": "string"}, "vars": {"answers": {"text": "🛡️ ok"}}, "expect": 5},
    {"id": "text_functions", "need": "Everyday text functions", "expr": "\"  SN-4471 \".trim() + \"|\" + \"a,b,c\".split(\",\").join(\"+\") + \"|\" + \"INC-2026-0142\".substring(0, 3) + \"|\" + string(\"INC-2026\".indexOf(\"-\")) + \"|\" + \"HIGH\".lowerAscii() + \"|\" + string(\"x.example\".endsWith(\".example\"))", "declare": {}, "vars": {}, "expect": "SN-4471|a+b+c|INC|3|high|true"},
    {"id": "divide_by_zero", "need": "Errors are errors, not crashes", "expr": "answers.count / answers.zero", "declare": {"answers.count": "int", "answers.zero": "int"}, "vars": {"answers": {"count": 10, "zero": 0}}, "error": {"kind": "runtime"}},
    {"id": "unknown_variable", "need": "Unknown names are rejected before anything runs", "expr": "nonexistent > 1", "declare": {}, "vars": {}, "error": {"kind": "compile", "message": "nonexistent isn't a name this template has."}},
    {"id": "unknown_answer", "need": "An answer the template doesn't have is rejected", "expr": "answers.summary == \"\"", "declare": {"answers.cvss": "double"}, "vars": {"answers": {"cvss": 1.0}}, "error": {"kind": "invalid", "message": "answers.summary isn't a name this template has."}},
    {"id": "type_error", "need": "Comparing text with a number is caught before anything runs", "expr": "answers.title >= 9.0", "declare": {"answers.title": "string"}, "vars": {"answers": {"title": "x"}}, "error": {"kind": "compile", "message": ">= doesn't work with text and a decimal number."}},
    {"id": "wrong_argument_type", "need": "A function given the wrong type is caught", "expr": "re_match(answers.cvss, \"9\")", "declare": {"answers.cvss": "double"}, "vars": {"answers": {"cvss": 9.0}}, "error": {"kind": "compile", "message": "re_match() can't take a decimal number and text."}},
    {"id": "mixed_branches", "need": "IF / ELSE branches must give the same type", "expr": "answers.cvss >= 9.0 ? \"Critical\" : 1", "declare": {"answers.cvss": "double"}, "vars": {"answers": {"cvss": 1.0}}, "error": {"kind": "compile", "message": "Both results of an IF / ELSE must be the same kind of value: here text and a whole number."}},
    {"id": "logical_needs_bool", "need": "AND and OR need yes or no", "expr": "answers.title && true", "declare": {"answers.title": "string"}, "vars": {"answers": {"title": "x"}}, "error": {"kind": "compile", "message": "AND (&&) and OR (||) need yes or no on both sides."}},
    {"id": "not_needs_bool", "need": "NOT needs yes or no", "expr": "!answers.title", "declare": {"answers.title": "string"}, "vars": {"answers": {"title": "x"}}, "error": {"kind": "compile", "message": "! doesn't work with text."}},
    {"id": "member_function_type", "need": "A text function given the wrong type", "expr": "answers.title.startsWith(1)", "declare": {"answers.title": "string"}, "vars": {"answers": {"title": "x"}}, "error": {"kind": "compile", "message": "startsWith() can't take text and a whole number."}},
    {"id": "unknown_nested_name", "need": "An unknown name with dots names its first part", "expr": "item.ip == \"\"", "declare": {"answers.cvss": "double"}, "vars": {}, "error": {"kind": "compile", "message": "item isn't a name this template has."}},
    {"id": "list_plus_number", "need": "Lists and numbers don't add up", "expr": "answers.tags + 1", "declare": {"answers.tags": "list<string>"}, "vars": {"answers": {"tags": []}}, "error": {"kind": "compile", "message": "+ doesn't work with a list and a whole number."}},
    {"id": "syntax_error", "need": "A syntax error is reported", "expr": "answers.cvss >= ", "declare": {"answers.cvss": "double"}, "vars": {"answers": {"cvss": 1.0}}, "error": {"kind": "compile"}},
    {"id": "unterminated_text", "need": "Text without its closing quote is reported", "expr": "\"Critical", "declare": {}, "vars": {}, "error": {"kind": "compile"}},
    {"id": "whole_namespace_refused", "need": "A whole group of names can't be used as a value", "expr": "answers.size() > 0", "declare": {"answers.cvss": "double"}, "vars": {"answers": {"cvss": 1.0}}, "error": {"kind": "invalid", "message": "answers on its own isn't a value: use one name inside it, such as answers.cvss."}},
    {"id": "unknown_function", "need": "Functions outside Skjald's list are refused", "expr": "answers.text.reverse()", "declare": {"answers.text": "string"}, "vars": {"answers": {"text": "abc"}}, "error": {"kind": "invalid", "message": "reverse() isn't a function Skjald knows."}},
    {"id": "unknown_global_function", "need": "Global functions outside the list are refused", "expr": "now() > 1", "declare": {}, "vars": {}, "error": {"kind": "invalid", "message": "now() isn't a function Skjald knows."}},
    {"id": "too_long", "need": "Expressions are limited to 2,000 characters", "expr": "\"\" == \"\"", "declare": {}, "vars": {}, "error": {"kind": "invalid", "message": "Expressions are limited to 2,000 characters."}},
    {"id": "re_match", "need": "Skjald re_match(): regular expression match on RE2", "expr": "re_match(answers.ip, \"^198\\\\.51\\\\.100\\\\.[0-9]+$\")", "declare": {"answers.ip": "string"}, "vars": {"answers": {"ip": "198.51.100.23"}}, "expect": true},
    {"id": "re_match_ipv6", "need": "re_match(): IPv6 pattern", "expr": "re_match(answers.ip, \"^[0-9a-f:]+$\")", "declare": {"answers.ip": "string"}, "vars": {"answers": {"ip": "2001:db8::5"}}, "expect": true},
    {"id": "re_match_lookahead", "need": "re_match(): non-RE2 syntax rejected on both sides", "expr": "re_match(answers.text, \"a(?=b)\")", "declare": {"answers.text": "string"}, "vars": {"answers": {"text": "abc"}}, "error": {"kind": "runtime"}},
    {"id": "re_match_backreference", "need": "re_match(): backreferences aren't RE2 either", "expr": "re_match(answers.text, \"(a)\\\\1\")", "declare": {"answers.text": "string"}, "vars": {"answers": {"text": "aa"}}, "error": {"kind": "runtime"}},
    {"id": "re_match_redos", "need": "re_match(): hostile pattern stays fast", "expr": "re_match(answers.text, \"^(a+)+$\")", "declare": {"answers.text": "string"}, "vars": {"answers": {"text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!"}}, "expect": false, "time_limit_ms": 100},
    {"id": "re_match_case", "need": "re_match(): case-insensitive with (?i)", "expr": "re_match(\"Critical\", \"(?i)^critical$\")", "declare": {}, "vars": {}, "expect": true},
    {"id": "comment_and_layout", "need": "Line breaks and comments are allowed", "expr": "answers.cvss >= 9.0 // critical\n  ? \"Critical\"\n  : \"Lower\"", "declare": {"answers.cvss": "double"}, "vars": {"answers": {"cvss": 9.8}}, "expect": "Critical"},
    {"id": "nested_names", "need": "Names nested more than one level, such as custom fields", "expr": "customer.custom.contract + \" \" + author.job_title", "declare": {"customer.custom.contract": "string", "author.job_title": "string"}, "vars": {"customer": {"custom": {"contract": "SLA-7"}}, "author": {"job_title": "Security consultant"}}, "expect": "SLA-7 Security consultant", "references": ["author.job_title", "customer.custom.contract"]},
    {"id": "library_names", "need": "Library variables and snippets", "expr": "\"Call \" + vars.support_phone + \". \" + text.handover", "declare": {"vars.support_phone": "string", "text.handover": "string"}, "vars": {"vars": {"support_phone": "+45 70 20 30 40"}, "text": {"handover": "The password was given by phone."}}, "expect": "Call +45 70 20 30 40. The password was given by phone."},
    {"id": "condition_type", "need": "The checked type of a condition is bool", "expr": "answers.attack_found && answers.cvss > 7.0", "declare": {"answers.attack_found": "bool", "answers.cvss": "double"}, "vars": {"answers": {"attack_found": true, "cvss": 7.5}}, "expect": true, "type": "bool"},
    {"id": "references_skip_locals", "need": "Names inside a list function and inside quotes aren't references", "expr": "answers.rows.exists(answers2, answers2.n > 0) && \"answers.cvss\" != \"\"", "declare": {"answers.rows": "list<map<string, dyn>>", "answers.cvss": "double"}, "vars": {"answers": {"rows": [{"n": 1}], "cvss": 1.0}}, "expect": true, "references": ["answers.rows"]}
  ]
}
